    "pdf_path": "",
    "eligibility_rules": {
      "logic": "all",
      "conditions": [
        {
          "field": "pmayg_household_in_final_secc_or_awaas_plus_eligible_list",
          "operator": "eq",
          "value": true,
          "reason": "PMAY-G beneficiaries are identified from SECC 2011 housing-deprivation parameters and finalized Awaas+ lists, subject to official verification."
        }
      ],
      "notes": "Do not estimate PMAY-G entitlement from income or rural residence alone. The official finalized list and verification process are decisive; absent confirmation, eligibility remains unknown."
    },
    "eligibility_sources": [
      "https://www.pib.gov.in/PressReleasePage.aspx?PRID=2155680&lang=2&reg=48"
    ]
  },
